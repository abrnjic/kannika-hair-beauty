{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:content",
  "installCommand": "npm ci --omit=dev --ignore-scripts",
  "outputDirectory": "dist",
  "redirects": [
    {"source": "/index.html", "destination": "/", "permanent": true},
    {"source": "/th/index.html", "destination": "/th/", "permanent": true},
    {"source": "/th", "destination": "/th/", "permanent": true},
    {"source": "/admin.html", "destination": "/admin", "permanent": true},
    {"source": "/club.html", "destination": "/club", "permanent": true},
    {"source": "/th/admin.html", "destination": "/th/admin", "permanent": true},
    {"source": "/th/club.html", "destination": "/th/club", "permanent": true}
  ],
  "headers": [
    {"source": "/admin", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/th/admin", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/club", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/th/club", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]},
    {"source": "/api/:path*", "headers": [{"key": "X-Robots-Tag", "value": "noindex"}]}
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://kannika-4f9b6.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/init.json",
      "destination": "https://kannika-4f9b6.firebaseapp.com/__/firebase/init.json"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/th/admin",
      "destination": "/th/admin.html"
    },
    {
      "source": "/th",
      "destination": "/th/index.html"
    },
    {
      "source": "/club",
      "destination": "/club.html"
    },
    {
      "source": "/th/club",
      "destination": "/th/club.html"
    }
  ],
  "functions": {
    "api/bookings.mjs": {
      "maxDuration": 60
    },
    "api/booking-status.mjs": {
      "maxDuration": 60
    },
    "api/loyalty-notification.mjs": {
      "maxDuration": 60
    },
    "api/loyalty-invitation.mjs": {
      "maxDuration": 60
    },
    "api/loyalty-activation.mjs": {
      "maxDuration": 60
    },
    "api/club-access.mjs": {
      "maxDuration": 60
    },
    "api/club-entry.mjs": {
      "maxDuration": 60
    },
    "api/service-menu.mjs": {
      "maxDuration": 30
    }
  }
}
