rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /bookings/{bookingId} {
      function authenticated() { return request.auth != null; }
      function validBooking() {
        let d = request.resource.data;
        return d.keys().hasAll(['service', 'date', 'time', 'name', 'email', 'notes', 'customerId', 'timezone', 'status', 'consent', 'createdAt'])
          && d.keys().hasOnly(['service', 'date', 'time', 'name', 'email', 'notes', 'customerId', 'timezone', 'status', 'consent', 'createdAt'])
          && d.customerId == request.auth.uid
          && d['service'] in ["Women's haircut", "Men's haircut", 'Wash & blow-dry', 'Hair styling & updos', 'Hair colour', 'Highlights', 'Hair care treatment', 'Manicure & nail shaping', 'Nail extensions', 'Nail polish & nail art', 'Eyelash extensions', 'Pedicure — women', 'Pedicure — men', 'Help me choose']
          && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.time in ['Morning', 'Afternoon', 'Evening']
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.email is string && d.email.size() <= 254 && d.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')
          && d.notes is string && d.notes.size() <= 1000
          && d.timezone == 'Asia/Bangkok' && d.status == 'pending'
          && d.consent == true && d.createdAt == request.time;
      }
      allow create: if authenticated() && validBooking();
      allow get: if authenticated() && (resource == null || resource.data.customerId == request.auth.uid);
      allow list, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
