rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && (request.auth.token.email == 'kannika54932@gmail.com'
          || (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner'));
    }
    match /admins/{adminId} {
      allow get: if request.auth != null && request.auth.uid == adminId
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
      allow list, create, update, delete: if false;
    }
    match /bookings/{bookingId} {
      function authenticated() { return request.auth != null; }
      function validBooking() {
        let d = request.resource.data;
        return d.keys().hasAll(['service', 'date', 'time', 'name', 'email', 'notes', 'customerId', 'timezone', 'status', 'consent', 'createdAt'])
          && d.keys().hasOnly(['service', 'date', 'time', 'name', 'email', 'notes', 'customerId', 'timezone', 'status', 'consent', 'createdAt', 'language'])
          && (!('language' in d) || d.language in ['en', 'th'])
          && d.customerId == request.auth.uid
          && d['service'] in ["Women's haircut", "Men's haircut", 'Wash & blow-dry', 'Hair styling & updos', 'Hair colour', 'Highlights', 'Hair care treatment', 'Manicure & nail shaping', 'Nail extensions', 'Nail polish & nail art', 'Eyelash extensions', 'Pedicure — women', 'Pedicure — men', 'Help me choose']
          && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.time in ['Morning', 'Afternoon', 'Evening']
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.email is string && d.email.size() <= 254 && d.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')
          && d.notes is string && d.notes.size() <= 1000
          && d.timezone == 'Asia/Bangkok' && d.status == 'pending'
          && d.consent == true && d.createdAt == request.time;
      }
      allow create: if authenticated() && validBooking();
      allow get: if isAdmin() || (authenticated() && (resource == null || resource.data.customerId == request.auth.uid));
      allow list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedDate', 'confirmedTime', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasAll(['status', 'confirmedDate', 'confirmedTime', 'updatedAt', 'updatedBy'])
        && request.resource.data.status in ['pending', 'confirmed', 'declined']
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.status == 'confirmed'
          && request.resource.data.confirmedDate is string && request.resource.data.confirmedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.confirmedTime is string && request.resource.data.confirmedTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
          || (request.resource.data.status != 'confirmed' && request.resource.data.confirmedDate == '' && request.resource.data.confirmedTime == ''));
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
